# --- Telegram ---
BOT_TOKEN=123456:your-bot-token-from-BotFather
ADMIN_IDS=111111111,222222222

# --- Environment ---
ENVIRONMENT=development
LOG_LEVEL=INFO
PORT=8080

# --- Database (matches docker-compose defaults) ---
DATABASE_URL=postgresql+asyncpg://animedb:animedb@db:5432/animedb

# --- Redis (optional, recommended once rate-limiting/FSM state is added) ---
REDIS_URL=redis://redis:6379/0

# --- Metadata providers ---
ANILIST_API_URL=https://graphql.anilist.co
ANILIST_RATE_LIMIT_PER_MINUTE=25
JIKAN_BASE_URL=https://api.jikan.moe/v4
JIKAN_RATE_LIMIT_PER_MINUTE=30
KITSU_BASE_URL=https://kitsu.io/api/edge
KITSU_RATE_LIMIT_PER_MINUTE=10
# SIMKL is not implemented yet (requires a signup-gated API key + doc
# verification) — see README section 4. Left here as a placeholder.
SIMKL_API_KEY=

# --- Background sync job ---
BACKGROUND_SYNC_ENABLED=true
BACKGROUND_SYNC_INTERVAL_SECONDS=3600
BACKGROUND_SYNC_BATCH_SIZE=20

# --- Cache TTLs (seconds) ---
CACHE_TTL_SEARCH=3600
CACHE_TTL_ANIME=21600
CACHE_TTL_AIRING=900

# --- Webhook mode (leave blank to use long polling) ---
WEBHOOK_URL=
WEBHOOK_SECRET=
